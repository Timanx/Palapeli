{
	"name": "kvik/palapeli",
	"description": "Web of the Palapeli puzzle hunt (registration, Palainfo, results, archive).",
	"type": "project",
	"license": "proprietary",
	"require": {
		"php": ">=8.4",
		"ext-fileinfo": "*",
		"ext-gd": "*",
		"ext-mbstring": "*",
		"ext-pdo_mysql": "*",
		"nette/application": "^3.2",
		"nette/bootstrap": "^3.2",
		"nette/database": "^3.2",
		"nette/di": "^3.2",
		"nette/forms": "^3.2",
		"nette/http": "^3.3",
		"nette/mail": "^4.0",
		"nette/robot-loader": "^4.0",
		"nette/utils": "^4.0",
		"latte/latte": "^3.0",
		"tracy/tracy": "^2.10",
		"endroid/qr-code": "^6.0"
	},
	"autoload": {
		"classmap": ["app/Bootstrap.php"]
	},
	"require-dev": {
		"nette/tester": "^2.5",
		"phpstan/phpstan": "^2.1",
		"phpstan/phpstan-nette": "^2.0"
	},
	"config": {
		"platform": {
			"php": "8.4"
		},
		"sort-packages": true
	},
	"scripts": {
		"phpstan": "phpstan analyse --memory-limit=1G",
		"lint:latte": "latte-lint app"
	},
	"minimum-stability": "stable"
}
