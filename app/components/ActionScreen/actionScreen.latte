{var $waitingForPickup = $cipherWait !== null}
<div n:if="$waitingForPickup" n:class="cipher-wait, $cipherWait['remaining'] > 0 ? waiting : ready" id="cipher-wait" data-remaining="{$cipherWait['remaining']}">
	<div class="cipher-wait-waiting">
		<div class="cipher-wait-timer cipher-wait-countdown">{$cipherWait['countdown']}</div>
		<p>
			Tato obrazovka zezelená v&nbsp;{$cipherWait['end']|date:'H:i:s'}.
			Pak obrazovku ukažte organizátorům a dostanete šifru.
		</p>
		<p n:if="$cipherWait['message'] !== null">{$cipherWait['message']}</p>
	</div>
	<div class="cipher-wait-ready">
		<div class="cipher-wait-ready-title">Tým <strong>{$cipherWait['teamName']}</strong> si již může vyzvednout šifru</div>
		<p>Po převzetí šifry zadejte níže kód, který je na ní napsaný.</p>
	</div>
</div>
<div n:foreach="$flashes as $flash" n:class="flash, $flash->type">{$flash->message}</div>
{if !$teamEnded && $hasPasswordSolution && !$waitingForPickup}
	{if $hasFinishCipher && $nextCheckpointNumber == $checkpointCount}
		<div class="flash info">K dokončení hry vám zbývá zadat cílové heslo.</div>
	{else}
		<div class="flash info">Řešením šifry je heslo. Po jeho zadání vám Palainfo vypíše polohu dalšího stanoviště.</div>
	{/if}
{/if}
<div n:if="$specification !== null" class="flash info">
	Upřesnítko {if $nextCheckpointNumber == 0}ke startu{elseif $nextCheckpointNumber == $checkpointCount - 1}k cíli{else}ke stanovišti {$nextCheckpointNumber}{/if}: {$specification}
</div>
<div class="action-screen-container screen-container">

	{if !$teamEnded && ($waitingForPickup || $hasPasswordSolution || $nextCheckpointNumber != $checkpointCount)}

		<div class="actions-container" id="actions-container" style="display: block;">
			<div class="checkpoint-heading">
				{if $waitingForPickup}
					{if $lastCheckpointData->checkpoint_number == 0}KÓD NA STARTOVNÍ ŠIFŘE{elseif $lastCheckpointData->checkpoint_number == $checkpointCount - 1}KÓD NA CÍLOVÉ ŠIFŘE{else}KÓD NA ŠIFŘE {$lastCheckpointData->checkpoint_number}{/if}
				{elseif $hasPasswordSolution}
					ŘEŠENÍ ŠIFRY
				{elseif $nextCheckpointNumber == 0}
					KÓD STARTOVNÍ ŠIFRY
				{elseif $nextCheckpointNumber == $checkpointCount - 1}
					KÓD CÍLOVÉHO STANOVIŠTĚ
				{else}
					KÓD STANOVIŠTĚ {$nextCheckpointNumber}
				{/if}
			</div>

			<div class="code-input-form">
				{form codeInput}
					{input code}{input send}
				{/form}
			</div>

			<div n:if="$nextCheckpointNumber > 0 && !$hasPasswordSolution && !$waitingForPickup" class="exit-time-forms-container">
				<div class="checkpoint-heading">
					{if $nextCheckpointNumber == 1}
						ODCHOD ZE STARTU
					{else}
						ODCHOD ZE STANOVIŠTĚ {$lastCheckpointData->checkpoint_number}
					{/if}
				</div>
				<div class="exit-time-input-form">
					{form exitTimeInput}{input exitTime}{input send}{/form}{if !isset($lastCheckpointData->exit_datetime)}{form exitTimeNow}{input send}{/form}{/if}

				</div>
			</div>

			<div n:if="$canAskForDead" class="open-dead-form button" onclick="toggleDeadScreen()">
				{if $lastCheckpointData->checkpoint_number == 0}TOTÁLKA KE STARTOVNÍ ŠIFŘE{else}TOTÁLKA K ŠIFŘE {$lastCheckpointData->checkpoint_number}{/if}
			</div>
			<br/>
			<div n:if="$nextCheckpointNumber > 0" class="open-end-form button" onclick="toggleEndScreen()">
				UKONČIT HRU
			</div>
		</div>
		<div class="dead-confirm-container" id="dead-confirm-container" style="display: none;">
			<div class="headline">
				OPRAVDU CHCETE TOTÁLNÍ NÁPOVĚDU?
			</div>
			<div class="consequences">
				Touto akcí zjistíte polohu následujícího stanoviště. Šifry přeskočené totální nápovědou se vám však
				nezapočítávají do výsledků. Pokud totální nápovědu opravdu chcete, zadejte znovu kód aktuální šifry:
			</div>

			<div class="code-input-form">
				{form askForDead}
					{input code}{input send}
				{/form}
			</div>
			<div class="cancel button" onclick="toggleDeadScreen()">
				ZPĚT
			</div>
		</div>
		<div class="end-confirm-container" id="end-confirm-container" style="display: none;">
			<div class="headline">
				OPRAVDU CHCETE UKONČIT HRU?
			</div>
			<div class="consequences">
				Touto akcí ukončíte hru. Nebudete moci zadávat hesla dalších stanovišť ani otevírat totální nápovědy.
				Zobrazí se vám poloha cíle a místo a čas konání afterparty. Chcete-li skutečně ukončit hru, zadejte do
				následujícího pole kód {$endCode}:
			</div>

			<div class="code-input-form">
				{form askForEnd}
					{input code}{input send}
				{/form}
			</div>
			<div class="cancel button" onclick="toggleEndScreen()">
				ZPĚT
			</div>
		</div>
	{/if}
</div>

<script>
    function toggleDeadScreen() {
        var actions = document.getElementById('actions-container');
        var dead = document.getElementById('dead-confirm-container');

        if (actions.style.display === 'block') {
            actions.style.display = 'none';
            dead.style.display = 'block';
        } else {
            dead.style.display = 'none';
            actions.style.display = 'block';
        }

    }

    function toggleEndScreen() {
        var actions = document.getElementById('actions-container');
        var end = document.getElementById('end-confirm-container');

        if (actions.style.display === 'block') {
            actions.style.display = 'none';
            end.style.display = 'block';
        } else {
            end.style.display = 'none';
            actions.style.display = 'block';
        }

    }

    // countdown of the wait for the cipher; turns the screen green without reloading (weak signal at the checkpoint)
    (function () {
        var wait = document.getElementById('cipher-wait');
        if (!wait || wait.className.indexOf('waiting') === -1) {
            return;
        }

        var end = Date.now() + parseInt(wait.getAttribute('data-remaining'), 10) * 1000;
        var countdowns = wait.getElementsByClassName('cipher-wait-countdown');
        var timer = setInterval(tick, 500);

        function tick() {
            var remaining = Math.ceil((end - Date.now()) / 1000);
            if (remaining <= 0) {
                clearInterval(timer);
                wait.className = 'cipher-wait ready';
                return;
            }

            var minutes = Math.floor(remaining / 60);
            var seconds = remaining % 60;
            var text = (minutes < 10 ? '0' : '') + minutes + ':' + (seconds < 10 ? '0' : '') + seconds;
            for (var i = 0; i < countdowns.length; i++) {
                countdowns[i].textContent = text;
            }
        }
    })();

	{if $defaultScreen === App\Components\ActionScreen\ActionScreen::EndScreen && !$teamEnded}
    toggleEndScreen();
	{elseif $defaultScreen === App\Components\ActionScreen\ActionScreen::DeadScreen && $canAskForDead}
    toggleDeadScreen();
	{/if}
</script>
