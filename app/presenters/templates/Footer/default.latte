<script>
	// close the year selector when clicking outside of it or pressing Escape
	document.addEventListener('click', function (e) {
		var selector = document.getElementById('yearSelector');
		if (selector && selector.open && !selector.contains(e.target)) {
			selector.open = false;
		}
	});
	document.addEventListener('keydown', function (e) {
		var selector = document.getElementById('yearSelector');
		if (e.key === 'Escape' && selector && selector.open) {
			selector.open = false;
			selector.querySelector('summary').focus();
		}
	});

	function handleMailForm(envelope) {
		var mailForm = document.getElementById('mailForm');
		var footer = document.getElementById('footer');
		var wrapper = document.getElementById('wrapper');
		var wrapperJS = document.getElementById('wrapperJS');

		if ($(window).width() > 940) {
			var responsiveModification = 0;
		} else {
			var responsiveModification = 18; // mobile footer height (responsive.css) minus the desktop one
		}

		if(mailForm.style.display == 'none') {
			mailForm.style.display = 'block';
			footer.style.height = (371 + responsiveModification) + 'px';
			wrapperJS.innerHTML= '.wrapper:after{ height: ' + (371 + responsiveModification) + 'px; }';
			wrapper.style.marginBottom = (-433 - responsiveModification) + 'px';
			window.scrollTo(0,document.body.scrollHeight);
		} else {
			mailForm.style.display = 'none';
			footer.style.height = (98 + responsiveModification) + 'px';
			wrapperJS.innerHTML= '.wrapper:after{ height: ' + (98 + responsiveModification) + 'px; }';
			wrapper.style.marginBottom = (-150 - responsiveModification) + 'px';
			window.scrollTo(0,document.body.scrollHeight);
		}

	}
</script>

<div>
	<div class="archive">
		{* year selector: the list opens upwards as a popover; the script above closes it on outside click / Escape *}
		<details class="yearSelector" id="yearSelector">
			<summary class="archiveHeader" title="Vybrat ročník">
				VYBRANÝ ROČNÍK: {$selectedYear}
				<svg class="yearSelectorIcon" width="14" height="14" viewBox="0 0 24 24" aria-hidden="true">
					<path d="M6 9l6 6 6-6" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"/>
				</svg>
			</summary>
			<div class="yearSelectorList">
				{foreach $archiveData as $row}
				<a class="archiveLink{if $selectedYear == $row['year']} selected{/if}" href="{plink Archive: $row['year'], $row['calendar_year'], $presenter->getAction(true)}" title="{$row['year']}. ročník ({$row['calendar_year']})">{$row['year']}</a>
				{/foreach}
			</div>
		</details>
	</div>{*
	*}<div class="contact">
		<p class="archiveHeader">KONTAKT</p>
		<a href="{plink Discussion:}" title="Diskuse">
			<div class="svgContainer" style="margin-right:30px;">
				{include ../../../components/SVG/discussion.svg, dim => '50px'}
			</div>
		</a>
		<div class="svgContainer" title="Zpráva organizátorům" style="margin-right:20px;cursor:pointer;" onclick="handleMailForm(this)">
			{include ../../../components/SVG/envelope.svg, dim => '50px'}
		</div>
		<a href="https://www.facebook.com/sifrovaci.hra.palapeli" title="Facebook" target="_blank">
			<div class="svgContainer" style="margin-right:10px;">
				{include ../../../components/SVG/facebook.svg, dim => '50px'}
			</div>
		</a>
	</div>
</div>
<div id="mailForm" style="display: none;margin-top: 30px;">
	<p class="archiveHeader">ZPRÁVA ORGANIZÁTORŮM</p>
	{control mailForm}
</div>
