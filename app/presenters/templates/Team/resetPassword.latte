{block content}

	{if $resetTeamName !== null}
		<p class="information">
			Zadejte nové heslo týmu <strong>{$resetTeamName}</strong>.
		</p>

		<div id="formValidationError" class="flash info"></div>

		{control resetPasswordForm}
	{else}
		<div class="flash info">Odkaz pro nastavení nového hesla je neplatný nebo již vypršel (platí 24 hodin a lze ho použít jen jednou). O nový odkaz si můžete požádat <a href="{plink Team:password}">ZDE</a>.</div>
	{/if}

{/block}
