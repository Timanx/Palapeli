{block content}
	{if isset($teamName)}
		{if $isSelectedYearCurrent}
			{if $hasRegistrationStarted && !$hasGameStarted && $registered}
				<div n:if="$hasPaid" class="flash info">
					{if !$isFeeReturnable}
						Startovné jste již zaplatili. Termín pro vrácení startovného ({$feeReturnDeadline|date: 'j. n. Y H:i'}) však již uplynul, po zrušení účasti vám ho proto nevrátíme.
					{elseif $feeReturnDeadline}
						Startovné jste již zaplatili. Pokud účast zrušíte nejpozději do {$feeReturnDeadline|date: 'j. n. Y H:i'}, vrátíme vám ho na účet, ze kterého jste platili. Po tomto termínu se startovné nevrací.
					{else}
						Startovné jste již zaplatili. Po zrušení účasti vám ho vrátíme na účet, ze kterého jste platili.
					{/if}
				</div>
				<div id="formValidationError" class="flash info"></div>
				{control cancelForm}
			{elseif !$registered}
				<div class="flash info">
					Do {$selectedYear}. ročníku nejste zaregistrovaní.{if $isRegistrationOpen} Můžete tak učinit kliknutím <a href="{plink Team:registerLogged}">SEM</a>.{/if}
				</div>
			{elseif !$hasRegistrationStarted}
				<div class="flash info">
					Registrace do {$selectedYear}. ročníku ještě nebyla spuštěna a takže ještě nejste zaregistrovaní a tudíž nemůžete ani zrušit účast.
				</div>
			{else}
				<div class="flash info">Aktuální ročník již proběhl, takže již není možné rušit účast.</div>
			{/if}
		{else}
			<div class="flash info">Rušení účasti v předchozích ročnících není možné. Přepnout do aktuálního ročníku se můžete <a href="{plink Archive: $currentYear, $currentCalendarYear, $presenter->getAction(true)}">ZDE</a>.</div>
		{/if}
	{else}
		<div class="flash info">Abyste mohli zrušit účast, musíte se nejprve přihlásit <a href="{plink Team:}">ZDE</a>.</div>
	{/if}

{/block}