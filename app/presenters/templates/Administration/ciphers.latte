{layout '@layout.latte'}

{block administrationBlock}
	<div class="information">Vybraný ročník: {$selectedYear}. ({$selectedCalendarYear})</div>
	<div class="selectForm">
		{control selectOnlyCheckpointForm}
	</div>


	{if isset($checkpoint)}

		<div class="flash info" n:if="!$hasFinishCipher && $checkpoint == $checkpointCount - 1">{$selectedYear}. ročník nemá cílovou šifru, relevantní je tedy pouze kód do Palainfa. Zadáním kódu tým hru dokončí.</div>
		<div class="flash info" n:if="$hasFinishCipher && $checkpoint == $checkpointCount - 1">Cíl: po zadání kódu cíle týmy do Palainfa zadávají cílové heslo (pole Řešení), čímž hru dokončí. Heslo může být řešením šifry vydané v cíli, nebo už řešením poslední šifry (ta pak vede na cíl jako běžné stanoviště, bez „Řešením je heslo“) – v tom případě to týmům řekněte ve „Zprávě po zadání kódu“. Totálka na cíl není.</div>
			<h2 class="heading">{if $checkpoint == 0}START{elseif $checkpoint == $checkpointCount - 1}CÍL{else}STANOVIŠTĚ {$checkpoint}{/if}</h2>
		<div class="cipherForm">
			{control cipherForm}
		</div>
	{/if}
{/block}